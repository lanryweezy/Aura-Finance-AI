# Environment Variables for Aura Finance AI

# ===== FRONTEND ENVIRONMENT VARIABLES =====
# Google Gemini AI API Key for AI features
GEMINI_API_KEY=your_gemini_api_key_here

# API URL (automatically configured for different environments)
# Development: http://localhost:8000  
# Production: https://your-backend-url.onrender.com
VITE_API_URL=

# ===== BACKEND ENVIRONMENT VARIABLES =====
# Environment type
ENVIRONMENT=development

# Frontend URL for CORS configuration
FRONTEND_URL=https://your-frontend-url.onrender.com

# Database Configuration (for production)
DATABASE_URL=postgresql://username:password@host:port/database

# Server Configuration
PORT=8000

# Paystack Payment Integration
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ===== RENDER DEPLOYMENT VARIABLES =====
# These are automatically configured by Render, but can be overridden

# Node.js version for frontend
NODE_VERSION=18.17.0

# Python version for backend  
PYTHON_VERSION=3.11.0